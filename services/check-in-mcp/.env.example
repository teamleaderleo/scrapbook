# How OpenAI reaches the private MCP service:
# - bearer: an OAuth-capable public gateway authenticates the user and injects the backend token
# - tunnel: OpenAI Secure MCP Tunnel reaches a loopback-only local server
SCRAPBOOK_INGRESS_MODE=bearer

# Safe default. Use full only for a write-capable ChatGPT workspace and an approved acceptance test.
SCRAPBOOK_TOOL_PROFILE=read-only

# Merge is a separate destructive capability and remains hidden unless explicitly enabled.
SCRAPBOOK_ALLOW_MERGE=false

# Backend guard for bearer ingress. This is not user OAuth and must never be entered into ChatGPT directly.
SCRAPBOOK_MCP_BEARER_TOKEN=replace-with-a-long-random-value

# Fine-grained token restricted to teamleaderleo/scrapbook for the private prototype.
# Required repository permissions: Actions (write), Contents (write), Pull requests (write), Metadata (read), Checks (read), Commit statuses (read).
SCRAPBOOK_GITHUB_TOKEN=github_pat_replace_me

# Optional comma-separated browser origins. Server-to-server clients normally omit Origin.
SCRAPBOOK_ALLOWED_ORIGINS=

# Tunnel ingress must use a loopback host. Bearer ingress normally uses 0.0.0.0 behind the gateway.
HOST=0.0.0.0
PORT=8787

# Public OAuth scope contract advertised by the tools:
# scrapbook.checkins.read
# scrapbook.checkins.write
# scrapbook.checkins.review
# scrapbook.checkins.merge
