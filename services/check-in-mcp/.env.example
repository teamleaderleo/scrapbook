# Inbound private-app authentication. Required in production.
SCRAPBOOK_MCP_BEARER_TOKEN=replace-with-a-long-random-value

# Fine-grained token restricted to teamleaderleo/scrapbook for the private prototype.
# Required repository permissions: Actions (write), Contents (write), Pull requests (write), Metadata (read), Checks (read), Commit statuses (read).
SCRAPBOOK_GITHUB_TOKEN=github_pat_replace_me

# Optional comma-separated browser origins. Server-to-server clients normally omit Origin.
SCRAPBOOK_ALLOWED_ORIGINS=

PORT=8787
